# ── Base de datos (Neon, Supabase, o cualquier PostgreSQL) ──────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────────────
SECRET_KEY=genera_una_clave_segura_de_al_menos_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Clave maestra para registro del primer superadmin ─────────────────────
MASTER_KEY=clave_secreta_para_primer_superadmin

# ── Cloudinary (almacenamiento de evidencias) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret